<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="photos.controller.AdminController"
            style="-fx-padding: 10;">
    <top>
        <Label fx:id="adminLabel"
               text="Admin - User Management"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER" />
    </top>

    <center>
        <HBox spacing="12" BorderPane.alignment="CENTER">
            <children>
                <!-- User list -->
                <VBox spacing="6">
                    <children>
                        <Label text="Existing Users:" />
                        <ListView fx:id="userListView"
                                  prefWidth="200.0"
                                  prefHeight="260.0" />
                    </children>
                </VBox>

                <!-- Controls -->
                <VBox spacing="10">
                    <children>
                        <Label text="Add / Delete User:" />
                        <TextField fx:id="usernameField"
                                   promptText="Username" />

                        <HBox spacing="8">
                            <children>
                                <Button text="Add User" onAction="#handleAddUser" />
                                <Button text="Delete User" onAction="#handleDeleteUser" />
                            </children>
                        </HBox>

                        <Separator />

                        <Button text="Logout" onAction="#handleLogout" />
                    </children>
                    <padding>
                        <Insets top="5" right="5" bottom="5" left="5"/>
                    </padding>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
