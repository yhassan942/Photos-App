<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="photos.controller.AlbumsController"
      spacing="10"
      style="-fx-padding: 20;">
    <children>
        <Label fx:id="userLabel"
               text="Albums"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <ListView fx:id="albumListView"
                  prefHeight="200.0" />

        <HBox spacing="10">
            <children>
                <TextField fx:id="albumNameField"
                           promptText="Album name" />
                <Button text="Add Album"
                        onAction="#handleAddAlbum" />
                <Button text="Rename Album"
                        onAction="#handleRenameAlbum" />
                <Button text="Delete Album"
                        onAction="#handleDeleteAlbum" />
            </children>
        </HBox>

        <HBox spacing="10">
            <children>
                <Button text="Open Album"
                        onAction="#handleOpenAlbum" />
                <Button text="Search Photos"
                        onAction="#handleSearch" />
                <Button text="Logout"
                        onAction="#handleLogout" />
            </children>
        </HBox>
    </children>
</VBox>
