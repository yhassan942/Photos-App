<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="photos.controller.LoginController"
      alignment="CENTER"
      spacing="10"
      style="-fx-padding: 20;">
    <children>
        <Label text="Photos Login" style="-fx-font-size: 18px;" />
        <TextField fx:id="usernameField" promptText="Username" maxWidth="200" />
        <Button text="Login" onAction="#handleLogin" maxWidth="200" />
    </children>
</VBox>
